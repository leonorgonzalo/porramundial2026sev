{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "porramundial2026sev",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "index.ts",
  "assets": {
    "directory": "."
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "porra-db"
    }
  ]
}
